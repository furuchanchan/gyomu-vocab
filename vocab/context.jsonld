{
  "@context": {
    "@version": 1.1,
    "gyomu": "https://w3id.org/gyomu/ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "void": "http://rdfs.org/ns/void#",
    "p-plan": "http://purl.org/net/p-plan#",
    "id": "@id",
    "type": "@type",
    "Department": "gyomu:Department",
    "Workflow": "gyomu:Workflow",
    "Stage": "gyomu:Stage",
    "Step": "gyomu:Step",
    "Role": "gyomu:Role",
    "Artifact": "gyomu:Artifact",
    "Regulation": "gyomu:Regulation",
    "ToolKind": "gyomu:ToolKind",
    "PcfElement": "gyomu:PcfElement",
    "label": { "@id": "rdfs:label", "@container": "@language" },
    "description": { "@id": "dcterms:description", "@container": "@language" },
    "title": { "@id": "dcterms:title", "@container": "@language" },
    "creator": { "@id": "dcterms:creator", "@container": "@language" },
    "publisher": { "@id": "dcterms:publisher", "@container": "@language" },
    "rights": { "@id": "dcterms:rights", "@container": "@language" },
    "note": { "@id": "skos:note", "@container": "@language" },
    "license": { "@id": "dcterms:license", "@type": "@id" },
    "conformsTo": { "@id": "dcterms:conformsTo", "@type": "@id" },
    "source": { "@id": "dcterms:source", "@type": "@id", "@container": "@set" },
    "identifier": "dcterms:identifier",
    "notation": "skos:notation",
    "version": "dcterms:hasVersion",
    "isVersionOf": { "@id": "dcterms:isVersionOf", "@container": "@language" },
    "modified": { "@id": "dcterms:modified", "@type": "xsd:date" },
    "vocabulary": { "@id": "void:vocabulary", "@type": "@id" },
    "hasWorkflow": { "@id": "gyomu:hasWorkflow", "@type": "@id", "@container": "@set" },
    "hasStage": { "@id": "gyomu:hasStage", "@type": "@id", "@container": "@set" },
    "hasStep": { "@id": "gyomu:hasStep", "@type": "@id", "@container": "@set" },
    "order": { "@id": "gyomu:order", "@type": "xsd:integer" },
    "next": { "@id": "gyomu:next", "@type": "@id" },
    "isPrecededBy": { "@id": "p-plan:isPrecededBy", "@type": "@id" },
    "isStepOfPlan": { "@id": "p-plan:isStepOfPlan", "@type": "@id" },
    "performedBy": { "@id": "gyomu:performedBy", "@type": "@id" },
    "confirmedBy": { "@id": "gyomu:confirmedBy", "@type": "@id" },
    "receives": { "@id": "gyomu:receives", "@type": "@id", "@container": "@set" },
    "produces": { "@id": "gyomu:produces", "@type": "@id", "@container": "@set" },
    "doneWhen": { "@id": "gyomu:doneWhen", "@container": "@language" },
    "requiresJudgment": { "@id": "gyomu:requiresJudgment", "@type": "xsd:boolean" },
    "judgment": { "@id": "gyomu:judgment", "@container": "@language" },
    "irreversible": { "@id": "gyomu:irreversible", "@type": "xsd:boolean" },
    "humanRequired": { "@id": "gyomu:humanRequired", "@type": "xsd:boolean" },
    "humanRequiredReason": { "@id": "gyomu:humanRequiredReason", "@container": "@language" },
    "aiAllocation": { "@id": "gyomu:aiAllocation", "@type": "@id" },
    "usesToolKind": { "@id": "gyomu:usesToolKind", "@type": "@id", "@container": "@set" },
    "timing": { "@id": "gyomu:timing", "@container": "@language" },
    "frequency": { "@id": "gyomu:frequency", "@type": "@id" },
    "artifactKind": { "@id": "gyomu:artifactKind", "@type": "@id" },
    "fromOutside": { "@id": "gyomu:fromOutside", "@type": "xsd:boolean" },
    "external": { "@id": "gyomu:external", "@type": "xsd:boolean" },
    "sender": { "@id": "gyomu:sender", "@type": "@id" },
    "recipient": { "@id": "gyomu:recipient", "@type": "@id" },
    "relatedRegulation": { "@id": "gyomu:relatedRegulation", "@type": "@id", "@container": "@set" },
    "legalBasis": { "@id": "gyomu:legalBasis", "@type": "@id", "@container": "@set" },
    "legalBasisArticle": { "@id": "gyomu:legalBasisArticle", "@container": "@language" },
    "officialGuidance": { "@id": "gyomu:officialGuidance", "@type": "@id", "@container": "@set" },
    "authority": { "@id": "gyomu:authority", "@container": "@language" },
    "obligation": { "@id": "gyomu:obligation", "@container": "@language" },
    "deadline": { "@id": "gyomu:deadline", "@container": "@language" },
    "appliesTo": { "@id": "gyomu:appliesTo", "@container": "@language" },
    "verifiedOn": { "@id": "gyomu:verifiedOn", "@type": "xsd:date" },
    "occupationClass": { "@id": "gyomu:occupationClass", "@type": "@id" },
    "occupationCode": "gyomu:occupationCode",
    "industryClass": { "@id": "gyomu:industryClass", "@type": "@id", "@container": "@set" },
    "pcfElement": { "@id": "gyomu:pcfElement", "@type": "@id", "@container": "@set" }
  }
}
